# ViralShelf Server v2.0 — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVER ───────────────────────────────────────────────────────────────────
PORT=4317
# Dashboard will be at http://127.0.0.1:4317

# ── AIRTABLE ─────────────────────────────────────────────────────────────────
# Personal Access Token — create at airtable.com/create/tokens
# Scopes needed: data.records:read, data.records:write
AIRTABLE_PAT=patXXXXXXXXXXXXXXXX
# Base ID — found in your base URL: airtable.com/appXXXXX/...
AIRTABLE_BASE=appXXXXXXXXXXXXXX

# ── ETSY OPEN API v3 ─────────────────────────────────────────────────────────
# API keystring from developer.etsy.com (always required, even with OAuth)
ETSY_KEYSTRING=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Your shop name (not ID) — e.g. "ViralShelfShop"
ETSY_SHOP_ID=YourShopName
# OAuth2 credentials (for token auto-refresh)
# Create OAuth app at developer.etsy.com → Manage Apps → Create New App
# Redirect URI must be: http://127.0.0.1:4317/auth/etsy/callback
ETSY_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ETSY_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Initial access token (after running /auth/etsy/start in browser)
# The server auto-refreshes this — you only need to set it manually for first run
ETSY_OAUTH_TOKEN=
# Refresh token (persisted to SQLite after first auth, but set here as backup)
ETSY_REFRESH_TOKEN=

# ── RECRAFT API ──────────────────────────────────────────────────────────────
# Get key at recraft.ai/workspace → Settings → API Keys
# Cost: $0.08 per SVG (Recraft V4 vector_illustration)
RECRAFT_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── DEEPSEEK API ─────────────────────────────────────────────────────────────
# Get key at platform.deepseek.com/api-keys
# Model: deepseek-v4-flash | Cost: $0.14/1M input, $0.28/1M output (May 2026)
DEEPSEEK_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── DYNAMIC MOCKUPS ──────────────────────────────────────────────────────────
# Get key at dynamicmockups.com → API
DM_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── PINTEREST API v5 ─────────────────────────────────────────────────────────
# OAuth2 Bearer token from developers.pinterest.com
# Scopes needed: pins:write, boards:read
PIN_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Board ID to pin to (find in board URL or via GET /boards)
PIN_BOARD=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── TELEGRAM BOT ─────────────────────────────────────────────────────────────
# Create bot via @BotFather on Telegram → get token
TELEGRAM_BOT_TOKEN=XXXXXXXXXX:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Your Telegram chat ID (get it by messaging @userinfobot)
# This is the ONLY chat ID allowed to control the bot
TELEGRAM_ALLOWED_CHAT_ID=7117568471
# For webhook mode (requires a public URL / ngrok):
# Set this to your ngrok URL + /api/telegram/webhook
# Then POST to /api/telegram/set-webhook with { "url": "..." }
# Leave blank to use polling mode (works locally with no public URL)
TELEGRAM_WEBHOOK_URL=
